      m_Calls: []
  m_text: 'A communication system that represents letters and numbers using a series
    of on-off signals.


    Uses two types of signals: Dots (short signals) and
    Dashes (long signals).


    A "Dash" is three times as long as a "Dot".


    Each
    letter of the alphabet has a unique pattern (e.g., "A" is .- and "B" is -...).


    Can
    be transmitted via sound (beeps), light (flashes), or radio pulses.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 73b3610cd0a59124e9d630d19703118f, type: 2}
